{
  // Configuration Claude Code pour YouTube Live Translator

  "permissions": {
    // Mode accept_edit : Auto-accepte éditions, demande pour commandes
    "default_mode": "accept_edit",

    // Commandes autorisées sans demander permission
    "allowed_commands": [
      "npm *",
      "pnpm *",
      "git *",
      "node *",
      "npx *",
      "ls *",
      "cat *",
      "grep *",
      "find *",
      "tail *",
      "head *",
      "echo *",
      "curl *",
      "wget *",
      "gcloud *",
      "az *"
    ],

    // Patterns de fichiers à ne jamais éditer
    "never_edit": [
      "node_modules/**",
      "dist/**",
      "release/**",
      ".git/**",
      "package-lock.json",
      "credentials/*.json"
    ]
  },

  "hooks": {
    // Pre-tool : Bloquer commandes dangereuses
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "py hooks/validate-commands.py"
          }
        ]
      }
    ],

    // Post-tool : Auto-format après édition
    "post_tool_use": [
      {
        "tool": "Edit",
        "on": "success",
        "run": "bash .claude/hooks/post-tool-use.sh"
      },
      {
        "tool": "Write",
        "on": "success",
        "run": "bash .claude/hooks/post-tool-use.sh"
      }
    ],
        "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "py hooks/notifications.py"
          }
        ]
      }
    ],

    // Notifications : Alertes sonores/desktop
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "py hooks/notifications.py"
          }
        ]
      }
    ]
  },

  "context": {
    // Fichiers toujours inclus dans contexte
    "always_include": [
      "package.json",
      "tsconfig.json",
      ".env.example",
      "src/shared/types/**/*.ts"
    ],

    // Patterns à exclure du contexte
    "exclude": [
      "node_modules/**",
      "dist/**",
      "release/**",
      "coverage/**",
      "*.log",
      ".git/**"
    ]
  },

  "agents": {
    // Agents spécialisés disponibles
    "available": [
      "electron-expert",
      "audio-pipeline-expert",
      "cloud-services-expert",
      "typescript-expert",
      "testing-expert",
      "react-ui-expert"
    ],

    // Agent par défaut (aucun, utiliser selon besoin)
    "default": null
  },

  "commands": {
    // Commandes slash disponibles
    "available": [
      "dev-setup",
      "fix-latency",
      "test-pipeline",
      "debug-api",
      "build-release",
      "review-code"
    ]
  },

  "project": {
    "name": "YouTube Live Translator",
    "type": "electron-app",
    "language": "typescript",
    "framework": "electron+react",

    // Chemins importants
    "paths": {
      "source": "src/",
      "tests": "tests/",
      "build": "dist/",
      "release": "release/",
      "docs": [
        "architecture.md",
        "tech_stack.md",
        "deployment-guide.md"
      ]
    },

    // Scripts npm importants
    "scripts": {
      "dev": "npm run dev",
      "test": "npm test",
      "test_e2e": "npm run test:e2e",
      "lint": "npm run lint",
      "build": "npm run build",
      "package": "npm run package"
    }
  },

  "preferences": {
    // Préférences d'édition
    "auto_format": true,
    "format_on_save": true,

    // Style de code
    "code_style": {
      "indent": "2 spaces",
      "quotes": "single",
      "semicolons": true,
      "trailing_comma": "es5"
    },

    // Commentaires
    "comment_style": {
      "inline": "Concis, pourquoi pas quoi",
      "block": "JSDoc pour fonctions publiques",
      "todo": "Format: // TODO(username): Description"
    }
  },

  "workflow": {
    // Workflow recommandé
    "steps": [
      "1. Lire CLAUDE.md pour contexte projet",
      "2. Explorer code avec agents spécialisés",
      "3. Planifier modifications",
      "4. Implémenter avec types stricts",
      "5. Tester (unitaire + intégration)",
      "6. Review code (fix-latency si nécessaire)",
      "7. Commit avec message descriptif"
    ],

    // Pattern EPCT
    "epct": {
      "explore": "Utiliser agents pour comprendre architecture",
      "plan": "Définir approach et identify points modification",
      "code": "Implémenter avec TypeScript strict + tests",
      "test": "Valider avec test-pipeline et tests E2E"
    }
  },

  "conventions": {
    // Conventions nommage
    "naming": {
      "files": "kebab-case (audio-pipeline.ts)",
      "classes": "PascalCase (AudioPipeline)",
      "functions": "camelCase (startTranslation)",
      "constants": "UPPER_SNAKE_CASE (MAX_LATENCY)",
      "types": "PascalCase (TranslationRequest)",
      "interfaces": "I prefix optionnel (ISTTService)"
    },

    // Structure imports
    "imports": {
      "order": [
        "1. Node.js built-ins",
        "2. External dependencies",
        "3. Internal modules (@main, @renderer, @shared)",
        "4. Relative imports",
        "5. Types"
      ],
      "alias": {
        "@main": "src/main",
        "@renderer": "src/renderer",
        "@shared": "src/shared",
        "@preload": "src/preload"
      }
    }
  },

  "performance": {
    // Critères performance
    "targets": {
      "latency_total": "< 2000ms",
      "latency_optimal": "< 1500ms",
      "cpu_usage": "< 50%",
      "memory_usage": "< 500MB",
      "cache_hit_ratio": "> 20%",
      "test_coverage": "> 80%"
    },

    // Monitoring
    "monitoring": {
      "log_latency": true,
      "track_api_calls": true,
      "budget_tracking": true,
      "memory_profiling": "dev only"
    }
  }
}
