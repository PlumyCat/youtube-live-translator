# =============================================================================
# GOOGLE CLOUD SERVICES
# =============================================================================

# Google Cloud API Key (or path to credentials.json)
GOOGLE_CLOUD_API_KEY=your_api_key_here
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-cloud-key.json

# Project ID Google Cloud
GOOGLE_CLOUD_PROJECT_ID=your-project-id

# =============================================================================
# DEEPL TRANSLATION
# =============================================================================

# DeepL API Key (Free or Pro)
DEEPL_API_KEY=your_deepl_api_key_here

# =============================================================================
# AZURE SERVICES (Alternative)
# =============================================================================

# Azure Speech Services
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=westeurope

# Azure Translator
AZURE_TRANSLATOR_KEY=your_azure_translator_key
AZURE_TRANSLATOR_REGION=westeurope
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com/

# =============================================================================
# ELEVENLABS (Alternative TTS)
# =============================================================================

ELEVENLABS_API_KEY=your_elevenlabs_api_key

# =============================================================================
# SERVICE PROVIDERS CONFIGURATION
# =============================================================================

# Choice of providers (google | azure | whisper | elevenlabs | deepl)
STT_PROVIDER=google
TRANSLATION_PROVIDER=deepl
TTS_PROVIDER=google

# =============================================================================
# AUDIO CONFIGURATION
# =============================================================================

# Audio chunk duration in milliseconds (500-5000)
AUDIO_CHUNK_DURATION=1500

# Source language for STT
STT_LANGUAGE=en-US

# Audio sample rate (Hz)
AUDIO_SAMPLE_RATE=16000

# =============================================================================
# LATENCY CONFIGURATION
# =============================================================================

# Maximum target latency (ms)
TARGET_LATENCY=2000

# Automatic adjustment threshold (ms)
LATENCY_ADJUSTMENT_THRESHOLD=2500

# Monitoring interval (ms)
MONITORING_INTERVAL=1000

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================

# Enable translation cache
CACHE_ENABLED=true

# Cache TTL in seconds (86400 = 24h)
CACHE_TTL=86400

# Maximum LRU cache size
CACHE_MAX_SIZE=1000

# =============================================================================
# LOGGING
# =============================================================================

# Log level (debug | info | warn | error)
LOG_LEVEL=info

# Enable detailed API logging
API_LOGGING_ENABLED=true

# =============================================================================
# RATE LIMITING
# =============================================================================

# Max STT requests per minute
STT_RATE_LIMIT_PER_MIN=1000

# Max Translation requests per minute
TRANSLATION_RATE_LIMIT_PER_MIN=500

# Max TTS requests per minute
TTS_RATE_LIMIT_PER_MIN=500

# =============================================================================
# BUDGET TRACKING
# =============================================================================

# Monthly budget in USD
MONTHLY_BUDGET=100

# Enable budget alerts
BUDGET_ALERTS_ENABLED=true

# Alert threshold (percentage of budget)
BUDGET_ALERT_THRESHOLD=80

# =============================================================================
# NETWORK MONITORING
# =============================================================================

# Enable network quality monitoring
NETWORK_MONITORING_ENABLED=true

# Ping interval (ms)
NETWORK_PING_INTERVAL=10000

# =============================================================================
# DEVELOPMENT
# =============================================================================

# Environment (development | production)
NODE_ENV=development

# Open DevTools on startup
OPEN_DEV_TOOLS=true

# Enable hot reload
HOT_RELOAD=true

# =============================================================================
# AUTO-UPDATE
# =============================================================================

# Enable auto-update
AUTO_UPDATE_ENABLED=true

# Check updates on startup
CHECK_UPDATES_ON_STARTUP=true

# Update check interval (hours)
UPDATE_CHECK_INTERVAL_HOURS=6
